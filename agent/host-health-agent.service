[Unit]
Description=alfaEdge Pulse Host Health push agent (one-shot, triggered by host-health-agent.timer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The bench's own OS user (the same one that runs bench itself) — nothing
# this script does needs root, and it must run as this user to have both
# read access to sites/*/site_config.json and permission to run
# `bench execute` in that bench's own env. Filled in by install.py; if
# installing by hand, replace __PULSE_AGENT_USER__ yourself.
User=__PULSE_AGENT_USER__
ExecStart=/usr/bin/python3 /opt/host-health-agent/host_health_agent.py --config /etc/host-health-agent/config.json
